# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=APP_NAME

# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Seed admin user (first run only — used by /api/auth/seed-admin to create or update the admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Environment ("production" enables stricter security headers + docs gating)
NODE_ENV=development

# Rate limiting (requests per IP per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# API docs (/docs). Open in development. In production the docs require
# ?token=<this value>; leave empty to disable the docs entirely in production.
API_DOCS_TOKEN=
